{
  "name": "go-practice-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json && tsc --noEmit --pretty false -p tsconfig.test.json",
    "check": "biome check --error-on-warnings .",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@tabler/icons-react": "3.49.0",
    "goban": "8.3.226",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.1.0"
  }
}
